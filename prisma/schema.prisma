generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SagaExecution {
  id            String   @id @default(uuid())
  sagaType      String   @map("saga_type")
  aggregateId   String   @map("aggregate_id")
  currentStep   Int      @default(0) @map("current_step")
  status        String   @default("pending") // pending, running, completed, failed, compensating, compensated
  context       Json     @default("{}")
  completedSteps Json    @default("[]") @map("completed_steps")
  error         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([aggregateId])
  @@index([status])
  @@map("saga_executions")
}

model EventStore {
  id            String   @id @default(uuid())
  aggregateId   String   @map("aggregate_id")
  aggregateType String   @map("aggregate_type")
  eventType     String   @map("event_type")
  version       Int
  payload       Json
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([aggregateId, version])
  @@index([aggregateId])
  @@index([aggregateType])
  @@index([eventType])
  @@map("event_store")
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  key         String   @unique
  response    Json
  statusCode  Int      @map("status_code")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}

model WebhookDelivery {
  id            String   @id @default(uuid())
  registrationId String  @map("registration_id")
  eventType     String   @map("event_type")
  payload       Json
  url           String
  status        String   @default("pending") // pending, delivered, failed, dead_lettered
  attempts      Int      @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at")
  nextRetryAt   DateTime? @map("next_retry_at")
  lastError     String?  @map("last_error")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([nextRetryAt])
  @@map("webhook_deliveries")
}

model WebhookRegistration {
  id        String   @id @default(uuid())
  url       String
  events    Json     @default("[\"*\"]")
  secret    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("webhook_registrations")
}

model DeadLetterQueue {
  id            String   @id @default(uuid())
  sourceType    String   @map("source_type") // webhook, saga
  sourceId      String   @map("source_id")
  payload       Json
  error         String
  attempts      Int
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([sourceType])
  @@map("dead_letter_queue")
}

model EventSnapshot {
  id            String   @id @default(uuid())
  aggregateId   String   @unique @map("aggregate_id")
  aggregateType String   @map("aggregate_type")
  version       Int
  state         Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("event_snapshots")
}
