# Database connection
DATABASE_URL=postgresql://payment_user:payment_pass@localhost:5432/payment_orchestrator

# Server configuration
PORT=3000
NODE_ENV=development

# Webhook HMAC secret for signing payloads
WEBHOOK_SECRET=your-webhook-secret-here

# External service simulation
PAYMENT_PROVIDER_FAILURE_RATE=0.1
INVENTORY_SERVICE_FAILURE_RATE=0.05
NOTIFICATION_SERVICE_FAILURE_RATE=0.05

# Circuit breaker defaults
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_MS=30000

# Idempotency key TTL (24 hours in milliseconds)
IDEMPOTENCY_TTL_MS=86400000
